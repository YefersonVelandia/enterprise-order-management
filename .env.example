# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto del servidor HTTP (entero entre 1 y 65535)
PORT=3000

# URL de conexión a PostgreSQL (obligatoria; no hay valor por defecto).
# Ejemplo local con Docker Compose:
# postgresql://postgres:postgres@localhost:5432/eoms
DATABASE_URL=

# Nivel de logs de Pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Orígenes CORS permitidos, separados por comas (opcional).
# - Definido: solo se permiten esos orígenes en cualquier entorno.
# - Vacío en desarrollo: se permiten orígenes http(s)://localhost.
# - Vacío en producción: CORS queda deshabilitado (nunca se usa `*`).
# Ejemplo: http://localhost:5173,https://app.midominio.com
CORS_ORIGINS=
